{
  "expo": {
    "name": "Ma3",
    "slug": "ma3",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ma3",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#006B3F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ma3.app",
      "buildNumber": "1",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Ma3 needs your location to find nearby matatus and track your trip.",
        "NSLocationAlwaysUsageDescription": "Ma3 needs your location to provide real-time trip tracking and safety features.",
        "UIBackgroundModes": ["location", "fetch"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#006B3F"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.ma3.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-location",
      "expo-splash-screen"
    ],
    "assetBundlePatterns": [
      "assets/**/*",
      "!assets/images/**/*.png",
      "!assets/images/**/*.jpg"
    ],
    "extra": {
      "eas": {}
    }
  }
}
